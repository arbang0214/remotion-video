  "title": [
    "어려운 문제일수록",
    "[[하나씩 적어야]] 해요"
  ],
  "crop": {
    "x": 0,
    "y": 0,
    "w": 1080,
    "h": 1000
  },
  "captions": [
    {
      "from": 0.0,
      "to": 2.3,
      "text": "자, 정답은"
    },
    {
      "from": 2.3,
      "to": 3.94,
      "text": "아, 이거 좀 갈라졌습니다"
    },
    {
      "from": 3.94,
      "to": 8.68,
      "text": "정답, [[700원]]입니다"
    },
    {
      "from": 8.68,
      "to": 11.86,
      "text": "맞았다! 맞았다!"
    },
    {
      "from": 11.86,
      "to": 14.9,
      "text": "맞은 친구, 솔직히\n이거 인정"
    },
    {
      "from": 14.9,
      "to": 17.3,
      "text": "꼼꼼한 거 인정합니다"
    },
    {
      "from": 18.98,
      "to": 21.36,
      "text": "680원! 680원\n손 들어 보자"
    },
    {
      "from": 21.36,
      "to": 24.44,
      "text": "680원 엄청 많았어,\n친구들"
    },
    {
      "from": 24.44,
      "to": 27.02,
      "text": "왜 700원이지?"
    },
    {
      "from": 27.02,
      "to": 29.66,
      "text": "친구들이 680원이\n너무 많아서"
    },
    {
      "from": 29.66,
      "to": 30.86,
      "text": "열심히 분석을 해 봤지"
    },
    {
      "from": 30.86,
      "to": 33.48,
      "text": "바로바로 그것만\n미리 말해 주면"
    },
    {
      "from": 33.48,
      "to": 39.4,
      "text": "붕어빵을 5개 + 낱개 4개\n살 수가 있고"
    },
    {
      "from": 39.4,
      "to": 43.38,
      "text": "또는 5개짜리를\n2개 살 수 있어요"
    },
    {
      "from": 43.38,
      "to": 48.5,
      "text": "근데 5개짜리 2개 사서\n10개 사는 게 [[더 싸요]]"
    },
    {
      "from": 48.5,
      "to": 50.22,
      "text": "이것이 [[함정]]이었습니다"
    },
    {
      "from": 50.22,
      "to": 51.65,
      "text": "이해됐습니까?"
    },
    {
      "from": 51.65,
      "to": 57.28,
      "text": "특히나 어려운 문제 풀 때\n진짜 도움이 돼요"
    },
    {
      "from": 57.28,
      "to": 59.08,
      "text": "친구들, 쉬운 문제 풀 때는\n암산하지"
    },
    {
      "from": 59.08,
      "to": 62.76,
      "text": "암산도 괜찮고,\n빠르게 푸는 것도 괜찮은데"
    },
    {
      "from": 62.76,
      "to": 67.04,
      "text": "어려운 문제 풀 때는\n[[하나씩 하나씩]] 적어야"
    },
    {
      "from": 67.04,
      "to": 68.64,
      "text": "더 잘 풀 수 있어요"
    }
  ],
