  "captions": [
    {
      "from": 0.0,
      "to": 1.28,
      "text": "이제 막 심화를\n시작한 친구들이"
    },
    {
      "from": 1.28,
      "to": 2.36,
      "text": "많이 틀리는 건\n[[당연한]] 겁니다"
    },
    {
      "from": 2.36,
      "to": 4.34,
      "text": "최상위 수학 하이레벨\n8, 9문제 중에"
    },
    {
      "from": 4.34,
      "to": 6.58,
      "text": "[[2, 3문제만]] 맞아도\n훌륭하게 출발하는 거예요"
    },
    {
      "from": 6.58,
      "to": 8.6,
      "text": "지금 목표는\n어려운 걸 맞히는 게 아니라"
    },
    {
      "from": 8.6,
      "to": 10.08,
      "text": "어려운 문제에\n[[익숙해지는]] 거예요"
    },
    {
      "from": 10.08,
      "to": 11.84,
      "text": "지금 당장\n틀린 개수가 아니라"
    },
    {
      "from": 11.84,
      "to": 14.88,
      "text": "그 개수가 조금씩\n[[줄어 가는지]] 확인해 보세요"
    }
  ],
  "teaser": [
    {
      "time": 5.5,
      "text": "[[2, 3문제]]면 충분합니다",
      "y": 0.8
    }
  ]
