  "captions": [
    {
      "from": 0.0,
      "to": 1.96,
      "text": "손 들어 준 거 고마워"
    },
    {
      "from": 1.96,
      "to": 4.06,
      "text": "선생님이 항상 말하지만"
    },
    {
      "from": 4.06,
      "to": 6.6,
      "text": "어려운 걸 어렵다고\n말할 수 있는 [[용기]]"
    },
    {
      "from": 6.6,
      "to": 8.8,
      "text": "아주 멋집니다"
    },
    {
      "from": 10.1,
      "to": 13.76,
      "text": "자, 정답을 보면…"
    },
    {
      "from": 13.76,
      "to": 18.08,
      "text": "정답은 [[538개]]예요"
    },
    {
      "from": 18.08,
      "to": 20.86,
      "text": "와, 전혀 찍어서\n맞힐 수 없는 숫자"
    },
    {
      "from": 20.86,
      "to": 21.44,
      "text": "나 맞혔다!"
    },
    {
      "from": 21.44,
      "to": 23.16,
      "text": "몇 명 맞혔던데?"
    },
    {
      "from": 23.16,
      "to": 25.8,
      "text": "와, 친구들 대단합니다"
    },
    {
      "from": 25.8,
      "to": 27.88,
      "text": "박수! 박수!\n이거 진짜 박수 쳐 주겠습니다"
    },
    {
      "from": 27.88,
      "to": 29.88,
      "text": "짧은 시간에 이렇게 푸는 거"
    },
    {
      "from": 29.88,
      "to": 32.28,
      "text": "자, 그러면"
    },
    {
      "from": 32.28,
      "to": 37.92,
      "text": "1부터 20까지 더하면\n몇일까?"
    },
    {
      "from": 37.92,
      "to": 42.94,
      "text": "1부터 20까지…"
    },
    {
      "from": 42.94,
      "to": 45.8,
      "text": "105요?"
    },
    {
      "from": 45.8,
      "to": 47.44,
      "text": "[[210]]입니다"
    },
    {
      "from": 47.44,
      "to": 51.66,
      "text": "20까지 더하면\n두 번 나눠 버렸네"
    },
    {
      "from": 51.66,
      "to": 55.8,
      "text": "그리고 30까지 더하면\n몇일까?"
    },
    {
      "from": 55.8,
      "to": 58.54,
      "text": "몇 개가 남는댔지?"
    },
    {
      "from": 58.54,
      "to": 60.66,
      "text": "10개가 남는데, 정삼각형은"
    },
    {
      "from": 60.66,
      "to": 64.92,
      "text": "그러니까 여기다가 또\n[[플러스 10]]을 해야 됩니다"
    },
    {
      "from": 64.92,
      "to": 75.4,
      "text": "475 · 506 · [[538]] · 581"
    },
    {
      "from": 75.4,
      "to": 78.94,
      "text": "그래서 위아래 다 있는 숫자는\n[[538]]입니다"
    },
    {
      "from": 78.94,
      "to": 81.6,
      "text": "이렇게 푸는 문제예요"
    },
    {
      "from": 81.6,
      "to": 83.96,
      "text": "이거 [[규칙 문제]]인지만\n알았으면"
    },
    {
      "from": 83.96,
      "to": 85.4,
      "text": "훨씬 많은 친구들이\n풀었을걸?"
    },
    {
      "from": 85.4,
      "to": 90.3,
      "text": "그래서 규칙 문제인지 몰라서\n아마 좀 헷갈렸을 것 같아"
    }
  ],
