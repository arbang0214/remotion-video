    {
      "from": 3.1,
      "to": 8.28,
      "text": "[[더해 보세요]], 더해 보십시오"
    },
    {
      "from": 8.28,
      "to": 9.96,
      "text": "과연 [[100]]일까요?"
    },
    {
      "from": 9.96,
      "to": 12.56,
      "text": "100도 아니고, 98도 아닙니다"
    },
    {
      "from": 12.56,
      "to": 14.02,
      "text": "[[101%]]입니다!"
    },
    {
      "from": 14.02,
      "to": 16.4,
      "text": "101%, 한 명도 없었던 거"
    },
    {
      "from": 16.4,
      "to": 18.98,
      "text": "\"나 101%였다\""
    },
    {
      "from": 18.98,
      "to": 21.82,
      "text": "이거 소수점 첫째 자리에서\n반올림하면"
    },
    {
      "from": 21.82,
      "to": 26.2,
      "text": "[[29%]]잖아, 그치?"
    },
    {
      "from": 26.2,
      "to": 28.54,
      "text": "반올림 [[전에]] 더하면 100입니다"
    },
    {
      "from": 28.54,
      "to": 32.0,
      "text": "반올림을 하고 [[나서]] 더하면\n101이 돼요"
    },
    {
      "from": 32.0,
      "to": 33.6,
      "text": "어떻게 된 거지?"
    },
    {
      "from": 33.6,
      "to": 36.14,
      "text": "지금 친구들 충격받은 표정이\n너무 큰데?"
    },
    {
      "from": 36.14,
      "to": 38.2,
      "text": "내가 다 더했는데 101이 나와"
    },
    {
      "from": 38.2,
      "to": 39.38,
      "text": "그럼 좀 당황스럽잖아"
    },
    {
      "from": 39.38,
      "to": 43.7,
      "text": "그럴 때 '아, [[이럴 수도 있구나]]'\n라고 생각하면 돼"
    }
