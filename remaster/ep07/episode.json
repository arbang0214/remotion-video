  "captions": [
    {
      "from": 0.0,
      "to": 2.28,
      "text": "많은 분들이 심화 문제를\n잘 푸는 것에만 집중합니다"
    },
    {
      "from": 2.28,
      "to": 3.64,
      "text": "하지만 더 중요한 것은"
    },
    {
      "from": 3.64,
      "to": 5.06,
      "text": "어려운 문제를\n많이 푸는 게 아니라"
    },
    {
      "from": 5.06,
      "to": 7.46,
      "text": "한 문제를 오랫동안\n[[생각할 수 있는 힘]]입니다"
    },
    {
      "from": 7.46,
      "to": 8.24,
      "text": "풀리지 않는 문제를"
    },
    {
      "from": 8.24,
      "to": 9.88,
      "text": "[[10분 넘게]] 고민하는 힘"
    },
    {
      "from": 9.88,
      "to": 12.28,
      "text": "그게 초등 심화에서\n얻어 가야 될 핵심입니다"
    },
    {
      "from": 12.28,
      "to": 13.26,
      "text": "중학교에 가면"
    },
    {
      "from": 13.26,
      "to": 14.88,
      "text": "어려운 문제가\n자꾸자꾸 나옵니다"
    },
    {
      "from": 14.88,
      "to": 16.48,
      "text": "거기에서 포기하느냐"
    },
    {
      "from": 16.48,
      "to": 17.3,
      "text": "붙들고 있느냐"
    },
    {
      "from": 17.3,
      "to": 19.28,
      "text": "초등 심화에서 기르는\n[[수학 근육]]은"
    },
    {
      "from": 19.28,
      "to": 21.55,
      "text": "바로 그때\n힘을 발휘합니다"
    }
  ],
  "teaser": [
    {
      "time": 17.0,
      "text": "[[포기]]하느냐, 붙들고 있느냐",
