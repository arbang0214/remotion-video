  },
  "captions": [
    {
      "from": 0.0,
      "to": 2.2,
      "text": "초등 심화의 핵심은\n아주 어려운 문제를 풀거나"
    },
    {
      "from": 2.2,
      "to": 4.12,
      "text": "빠르게 진도를\n나가는 게 [[아니에요]]"
    },
    {
      "from": 4.12,
      "to": 6.46,
      "text": "지금 우리 친구가\n소화할 수 있는 것보다"
    },
    {
      "from": 6.46,
      "to": 8.16,
      "text": "[[조금 더 어려운]] 강도를"
    },
    {
      "from": 8.16,
      "to": 9.96,
      "text": "[[지속적으로]] 경험하게 하는 거"
    },
    {
      "from": 9.96,
      "to": 11.32,
      "text": "그게 더 중요해요"
    },
    {
      "from": 11.32,
      "to": 13.08,
      "text": "한 번에 많이\n나가려고 하지 말고"
    },
    {
      "from": 13.08,
      "to": 14.82,
      "text": "어려운 거 한 번에\n풀려고 하지 말고"
    },
    {
      "from": 14.82,
      "to": 17.18,
      "text": "지금 우리 아이가\n할 수 있는 것보다"
    },
    {
      "from": 17.18,
      "to": 20.32,
      "text": "[[조금 더 어려운]] 강도를\n경험하게 해 보세요"
    }
  ],
  "teaser": [
    {
      "time": 3.0,
      "text": "어려운 문제가 [[답이 아니에요]]",
      "y": 0.8
    }
